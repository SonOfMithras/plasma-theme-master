{
  "name": "PTM",
  "author": "PTM",
  "version": 1,
  "theme": {
    "background": "{{ colors.surface.default.hex }}",
    "foreground": "{{ colors.on_surface.default.hex }}",
    "border": "#{{ colors.outline_variant.default.hex_stripped }}66",
    "muted": "{{ colors.surface_container_high.default.hex }}",
    "overlay": "#{{ colors.scrim.default.hex_stripped }}8c",
    "overlay_foreground": "{{ colors.on_surface.default.hex }}",
    "muted_foreground": "{{ colors.on_surface_variant.default.hex }}",
    "secondary": "{{ colors.surface_container.default.hex }}",
    "secondary_hover": "#{{ colors.surface_container_high.default.hex_stripped }}b3",
    "secondary_active": "#{{ colors.surface_container_highest.default.hex_stripped }}b3",
    "primary": "{{ colors.primary.default.hex }}",
    "primary_foreground": "{{ colors.on_primary.default.hex }}",
    "primary_hover": "#{{ colors.primary_container.default.hex_stripped }}b3",
    "danger": "{{ colors.error_container.default.hex }}",
    "danger_foreground": "{{ colors.on_error_container.default.hex }}",
    "danger_hover": "#{{ colors.error.default.hex_stripped }}b3",
    "popover": "{{ colors.surface_container.default.hex }}",
    "popover_foreground": "{{ colors.on_surface.default.hex }}",
    "progress_bar": "{{ colors.primary.default.hex }}",
