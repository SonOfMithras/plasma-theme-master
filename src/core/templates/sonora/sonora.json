    "sidebar": "{{ colors.surface_container_low.default.hex }}",
    "sidebar_accent": "#{{ colors.secondary_container.default.hex_stripped }}b3",
    "sidebar_border": "{{ colors.outline_variant.default.hex }}",
    "title_bar_border": "{{ colors.outline_variant.default.hex }}",
    "table_head": "#{{ colors.surface_container.default.hex_stripped }}e6",
    "table_head_foreground": "{{ colors.on_surface_variant.default.hex }}",
    "table_row_border": "#{{ colors.outline_variant.default.hex_stripped }}b3",
    "table_hover": "#{{ colors.surface_container_high.default.hex_stripped }}b3",
    "table_active": "#{{ colors.primary_container.default.hex_stripped }}66",
    "table_active_border": "{{ colors.primary.default.hex }}"
