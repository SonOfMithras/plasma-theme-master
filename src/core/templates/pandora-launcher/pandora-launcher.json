      "highlight": {
        "editor.foreground": "{{ colors.on_surface.default.hex }}",
        "editor.background": "{{ colors.background.default.hex }}",
        "editor.active_line.background": "{{ colors.surface_container.default.hex }}",
        "editor.line_number": "{{ colors.outline.default.hex }}",
        "editor.active_line_number": "{{ colors.on_surface.default.hex }}",
        "editor.invisible": "{{ colors.outline_variant.default.hex }}",
        "conflict": "{{ colors.error.default.hex }}",
        "created": "{{ colors.primary.default.hex }}",
        "hidden": "{{ colors.outline.default.hex }}",
        "hint": "{{ colors.tertiary.default.hex }}",
        "modified": "{{ colors.secondary.default.hex }}",
        "predictive": "{{ colors.surface_variant.default.hex }}",
        "syntax": {
          "attribute": {
            "color": "{{ palettes.secondary.70.hex }}"
          },
          "boolean": {
            "color": "{{ palettes.tertiary.70.hex }}"
          },
          "comment": {
            "color": "{{ colors.on_surface_variant.default.hex }}"
          },
          "comment.doc": {
            "color": "{{ colors.on_surface_variant.default.hex }}"
          },
          "constant": {
            "color": "{{ palettes.primary.70.hex }}"
          },
          "constructor": {
            "color": "{{ palettes.secondary.70.hex }}"
          },
          "embedded": {
            "color": "{{ colors.on_surface.default.hex }}"
          },
          "function": {
            "color": "{{ palettes.primary.70.hex }}"
          },
          "keyword": {
            "color": "{{ palettes.tertiary.70.hex }}"
          },
          "link_text": {
            "color": "{{ colors.primary.default.hex }}"
          },
          "link_uri": {
            "color": "{{ colors.secondary.default.hex }}"
          },
          "number": {
            "color": "{{ palettes.tertiary.70.hex }}"
          },
          "string": {
            "color": "{{ palettes.secondary.70.hex }}"
          },
          "string.escape": {
            "color": "{{ palettes.primary.70.hex }}"
          },
          "string.regex": {
            "color": "{{ palettes.primary.70.hex }}"
          },
          "string.special": {
            "color": "{{ palettes.tertiary.70.hex }}"
          },
          "string.special.symbol": {
            "color": "{{ palettes.tertiary.70.hex }}"
          },
          "tag": {
            "color": "{{ palettes.secondary.70.hex }}"
          },
          "text.literal": {
            "color": "{{ palettes.tertiary.70.hex }}"
          },
          "title": {
            "color": "{{ colors.primary.default.hex }}"
          },
          "type": {
            "color": "{{ palettes.secondary.70.hex }}"
          },
          "property": {
            "color": "{{ colors.on_surface.default.hex }}"
          },
          "variable.special": {
            "color": "{{ palettes.tertiary.70.hex }}"
          }
        }
