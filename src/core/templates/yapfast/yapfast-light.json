    "raised": "{{ colors.surface_container_lowest.light.hex }}",
    "field": "{{ colors.surface_container_lowest.light.hex }}",
    "sunken": "{{ colors.surface_container.light.hex }}",
    "hover": "{{ colors.surface_container_low.light.hex }}",
    "active": "{{ colors.surface_container_high.light.hex }}",
    "row-hover": "{{ colors.surface_container_lowest.light.hex }}",
    "line": "{{ colors.surface_container_high.light.hex }}",
    "edge": "{{ colors.outline_variant.light.hex }}",
    "text": "{{ colors.on_surface.light.hex }}",
