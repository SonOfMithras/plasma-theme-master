# Plasma Theme Master - Universal Template Configuration
#
# Application templates are managed automatically via the GUI (App Templates tab)
# or via CLI (plasma-theme-master sync-enable <app> / sync-disable <app>).
#
# Custom Templates:
# You can add custom application templates in two ways:
#
# 1. Place a template directory in:
#    ~/.local/share/plasma-theme-master/templates/<app_name>/template.toml
#
# 2. Or define custom templates directly in this file:
#    [templates.myapp]
#    enabled = true
#    input_path = '~/.config/plasma-theme-master/templates/myapp.tpl'
#    output_path = '~/.config/myapp/theme.conf'
#    palette = 'current'
#    post_hook = 'myapp --reload-theme'

[config]

[palette]
current = "Breeze"

[app_templates]

# ---------------------------------------------------------------------------
# Discord Imports (configured via App Templates GUI)
# ---------------------------------------------------------------------------

[discord.betterdiscord]
midnight_enabled = true
custom_imports = []

[discord.vencord]
midnight_enabled = true
custom_imports = []

# ---------------------------------------------------------------------------
# Obsidian Vaults & Auto-Detection
# ---------------------------------------------------------------------------

[obsidian]
auto_detect = true
vaults = []
