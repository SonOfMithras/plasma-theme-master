/**
 * @name Plasma Master (BetterDiscord)
 * @description A dynamic discord theme synchronized with KDE Plasma.
 * @author Plasma Theme Master
 * @version 1.0.0
 */
{{IMPORTS}}

:root {
  /* text colors */
  --text-0: {{WINDOW_BG}};
  --text-1: {{WINDOW_FG_LIGHT}};
  --text-2: {{WINDOW_FG}};
  --text-3: {{VIEW_FG}};
  --text-4: {{VIEW_FG_MUTED}};
  --text-5: {{VIEW_FG_DIM}};
  /* background and dark colors */
  --bg-1: {{BUTTON_BG_DARK}};
  --bg-2: {{BUTTON_BG}};
  --bg-3: {{VIEW_BG}};
  --bg-4: {{WINDOW_BG}};
  /* accent colors */
  --accent-1: {{ACCENT_LIGHT}};
  --accent-2: {{ACCENT}};
  --accent-3: {{ACCENT}};
  --accent-4: {{ACCENT_LIGHT}};
  --accent-5: {{ACCENT_DARK}};
  --accent-new: {{ERROR}};
  /* status indicator colors */
  --online: {{SUCCESS}};
  --dnd: {{ERROR}};
  --idle: {{WARNING}};
  --streaming: {{ANSI_MAGENTA}};
}
