[meta]
version = 1
name = "Plasma Theme Master"
description = "Dynamically generated theme matching KDE Plasma"
variant = "{{IS_DARK}}"
inherits = "{{INHERITS}}"

[colors.core]
accent = "{{ACCENT}}"
accent_foreground = "{{VIEW_BG}}"
background = "{{WINDOW_BG}}"
foreground = "{{VIEW_FG}}"
secondary_background = "{{WINDOW_BG_DARK}}"
border = "{{WINDOW_BG_DARK2}}"

[colors.accents]
blue = "{{ACCENT}}"
green = "{{SUCCESS}}"
red = "{{ERROR}}"
yellow = "{{WARNING}}"
